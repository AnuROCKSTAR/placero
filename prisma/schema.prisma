generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  branch       String?
  targetRole   String?
  role         String   @default("student")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  industry  String
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Mission {
  id        String   @id @default(cuid())
  title     String
  duration  Int
  xp        Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id        String   @id @default(cuid())
  title     String
  summary   String
  userEmail String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssessmentAttempt {
  id        String   @id @default(cuid())
  userEmail String
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIConversation {
  id        String   @id @default(cuid())
  userEmail String
  prompt    String
  answer    String
  createdAt DateTime @default(now())
}
